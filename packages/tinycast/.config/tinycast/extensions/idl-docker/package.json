{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "idl-docker",
  "title": "IDL Docker",
  "description": "Manage IDL Docker containers across git worktrees",
  "icon": "extension-icon.png",
  "author": "ammonkc",
  "categories": [
    "Developer Tools"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "start",
      "title": "Start Containers",
      "description": "Start IDL Docker containers for a worktree",
      "mode": "view"
    },
    {
      "name": "stop",
      "title": "Stop Containers",
      "description": "Stop IDL Docker containers for a worktree",
      "mode": "view"
    }
  ],
  "preferences": [
    {
      "name": "baseDir",
      "title": "Worktrees Directory",
      "description": "Base directory containing git worktrees",
      "type": "textfield",
      "required": true,
      "default": "~/Developer/code/indirect"
    },
    {
      "name": "defaultWorktree",
      "title": "Default Worktree",
      "description": "Default worktree to use",
      "type": "textfield",
      "required": false,
      "default": "main"
    },
    {
      "name": "allegroDomain",
      "title": "Allegro Domain",
      "description": "Domain for the ALLEGRO_DOMAIN environment variable",
      "type": "textfield",
      "required": false,
      "default": "indirect.test"
    }
  ],
  "dependencies": {
    "@raycast/api": "^2.11.1"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "build": "ray build -e dist -o build --non-interactive",
    "fix-lint": "eslint src --fix && prettier --write src",
    "lint": "eslint src && prettier --check src",
    "test": "tsc && node --test test/*.cjs"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "overrides": {
    "minimatch@^10.0.0": "^11.0.5"
  }
}
