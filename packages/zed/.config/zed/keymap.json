// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "Workspace",
    "bindings": {
      // "shift shift": "file_finder::Toggle"
      "alt-d u": [
        "task::Spawn",
        {
          "task_name": "DevContainer: Up"
        }
      ],
      "alt-d d": [
        "task::Spawn",
        {
          "task_name": "DevContainer: Down"
        }
      ]
    }
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      // "j k": "vim::NormalBefore"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "alt-cmd-down": "editor::SelectToEndOfParagraph"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "alt-cmd-up": "editor::SelectToStartOfParagraph"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "ctrl-shift-down": [
        "editor::AddSelectionBelow",
        {
          "skip_soft_wrap": true
        }
      ]
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "ctrl-shift-up": [
        "editor::AddSelectionAbove",
        {
          "skip_soft_wrap": true
        }
      ]
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "ctrl-cmd-p": [
        "editor::AddSelectionAbove",
        {
          "skip_soft_wrap": false
        }
      ]
    }
  }
]
