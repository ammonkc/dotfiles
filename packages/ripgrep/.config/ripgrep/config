## Type additions

--type-add
blade:*.{blade.php}

--type-add
laravelmodel:*/Models/**/*.php

--type-add
laravelaction:*/Actions/**/*.php

--type-add
laravelservice:*/Services/**/*.php

--type-add
laravelcontroller:*/Http/Controllers/**/*.php

--type-add
laravelcommand:*/Console/Commands/**/*.php

--type-add
laravelmigration:*/migrations/**/*.php

--type-add
laravelconfig:*/config/**/*.php

--type-add
laraveltest:*/tests/**/*.php

# Add my 'web' type.
--type-add
frontend:*.{blade.php,html,css,scss,js,jsx,ts,tsx}*

--type-add
laravel:include:laravelaction,laravelcommand,laravelservice,laravelmodel,laravelcontroller,laravelmigration,laravelconfig,laraveltest,blade,frontend

# add new types to search by
--type-add
style:*.{css,sass,less,stylus}

--type-add
spec:*.{spec,test}.{ts,tsx,js,jsx}

--type-add
test:*.{spec,test}.{php,ts,tsx,js,jsx}

--type-add
php:*.php

--type-add
ts:*.ts

--type-add
tsx:*.tsx

--type-add
js:*.js

--type-add
jsx:*.jsx

--type-add
json:*.json

--type-add
gql:*.{graphql,gql}

--type-add
pkg:package.json

# ignore case
--smart-case

# Markdown (and MDX)
--type-add
md:*.{md,mdx}

# follow symlinks
--follow

# include hidden files
--hidden

# Don't go into the .git/ directory
--glob=!.git/*
