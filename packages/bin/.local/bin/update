#!/usr/bin/env bash
#
# Wrapper script to update system packages and dotfiles
# Executes: task system:update

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Check if task is available
if ! command -v task >/dev/null 2>&1; then
  echo -e "${RED}Error: 'task' command not found${NC}"
  echo "Please ensure go-task is installed and in your PATH"
  exit 1
fi

# Check if we're in the dotfiles directory
DOTFILES_DIR="${DOTFILES_DIR:-$HOME/.dotfiles}"
DOTFILES_BRANCH="${DOTFILES_BRANCH:-main}"

if [[ ! -d "$DOTFILES_DIR" ]]; then
  echo -e "${RED}Error: Dotfiles directory not found at $DOTFILES_DIR${NC}"
  exit 1
fi

# Run the update task from the dotfiles directory
echo -e "${BLUE}Updating system packages and dotfiles...${NC}"
echo ""

cd "$DOTFILES_DIR"
# Auto-stash local changes (apps rewrite their own configs), then restore them after the pull.
stash_ref=""
if ! git diff-index --quiet HEAD -- 2>/dev/null; then
  echo -e "${BLUE}⚠️  Local changes detected - auto-stashing for safety${NC}"
  stash_msg="Auto-stash before update $(date +%Y-%m-%d-%H%M%S)-$$"
  if git stash push -m "$stash_msg" >/dev/null; then
    # Identify this run's stash by its unique message, never an older one.
    stash_ref="$(git stash list | grep -F "$stash_msg" | head -n 1 | cut -d: -f1)"
  fi
fi

# Pull latest changes
echo -e "${BLUE}📥 Updating from remote...${NC}"
if ! git pull --ff-only origin "$DOTFILES_BRANCH"; then
  if [[ -n "$stash_ref" ]]; then
    echo -e "${RED}Pull failed. Your changes remain in $stash_ref (git stash pop to restore)${NC}"
  fi
  exit 1
fi

if [[ -n "$stash_ref" ]]; then
  if git stash pop "$stash_ref" >/dev/null; then
    echo -e "${BLUE}ℹ️  Restored your local changes${NC}"
  else
    echo -e "${RED}Conflict restoring local changes. They are still saved in $stash_ref${NC}"
    echo -e "${RED}Resolve in $DOTFILES_DIR, then run: git stash drop $stash_ref${NC}"
    exit 1
  fi
fi

task system:update

echo ""
echo -e "${GREEN}✓ Update complete!${NC}"

