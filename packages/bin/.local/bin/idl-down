#!/bin/bash
#
# Stop IDL Docker containers
# Usage: idl-down [--profile NAME ...] [worktree] [domain]
#        worktree - current BASE_DIR worktree if cwd is inside one, else 'main'
#        BASE_DIR can be overridden with IDL_WORKTREES_DIR
#        domain   - defaults to 'allegro.test'
#

BASE_DIR="${IDL_WORKTREES_DIR:-$HOME/Developer/code/indirect}"
POSITIONAL=()
COMPOSE_PROFILES=(--profile sftp --profile queue)

validate_profile() {
    case "$1" in
        sftp|queue) ;;
        *) echo "Unknown Compose profile: $1 (available: sftp, queue)" >&2; exit 1 ;;
    esac
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --profile)
            if [[ -z "${2:-}" || "$2" == -* ]]; then
                echo "--profile requires a profile name" >&2
                exit 1
            fi
            validate_profile "$2"
            shift 2
            ;;
        --profile=*)
            profile="${1#--profile=}"
            if [[ -z "$profile" ]]; then
                echo "--profile requires a profile name" >&2
                exit 1
            fi
            validate_profile "$profile"
            shift
            ;;
        -h | --help)
            cat <<'EOF'
Usage: idl-down [--profile NAME ...] [worktree] [domain]

  --profile     Accept sftp or queue (both are already enabled for down)
  worktree      Defaults to cwd under ~/Developer/code/indirect, else main
  domain        Defaults to allegro.test
EOF
            exit 0
            ;;
        -*)
            echo "Unknown option: $1 (try --help)" >&2
            exit 1
            ;;
        *)
            POSITIONAL+=("$1")
            shift
            ;;
    esac
done

ALLEGRO_DOMAIN="${POSITIONAL[1]:-allegro.test}"

# Resolve worktree from arg, else from cwd under BASE_DIR, else 'main'
default_worktree() {
    local pwd_real base_real rel
    pwd_real="$(pwd -P 2>/dev/null)" || { echo main; return; }
    base_real="$(cd "$BASE_DIR" 2>/dev/null && pwd -P)" || { echo main; return; }
    if [[ "$pwd_real" == "$base_real"/* ]]; then
        rel="${pwd_real#"$base_real"/}"
        echo "${rel%%/*}"
    else
        echo main
    fi
}

WORKTREE="${POSITIONAL[0]:-$(default_worktree)}"

# Get list of available worktrees (directories in BASE_DIR)
# Uses fd if available, otherwise falls back to find
get_worktrees() {
    if command -v fd &>/dev/null; then
        fd --type d --max-depth 1 --base-directory "$BASE_DIR" . 2>/dev/null | sort
    else
        /usr/bin/find "$BASE_DIR" -mindepth 1 -maxdepth 1 -type d -exec basename {} \; 2>/dev/null | sort
    fi
}

PROJECT_DIR="$BASE_DIR/$WORKTREE"

# Validate worktree exists
if [[ ! -d "$PROJECT_DIR" ]]; then
    echo "❌ Worktree '$WORKTREE' not found"
    echo "Available: $(get_worktrees | tr '\n' ' ')"
    exit 1
fi

cd "$PROJECT_DIR" || { echo "❌ Cannot find $PROJECT_DIR"; exit 1; }

ALLEGRO_DOMAIN="$ALLEGRO_DOMAIN" docker compose -f docker-compose.yaml \
    "${COMPOSE_PROFILES[@]}" \
    down || exit $?

echo "✅ IDL containers stopped ($WORKTREE) @ $ALLEGRO_DOMAIN"
