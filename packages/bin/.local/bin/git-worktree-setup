#!/usr/bin/env bash
# Set up a new git worktree using paths listed in the primary's .worktree-copy.
# Usage: git-worktree-setup [-n] [-v] [--all] [SOURCE] [DEST]
#        git-worktree-setup [-n] [-v] [--all] DEST
#        git-worktree-setup                  # from inside the new worktree
#
# Agnostic: works with git CLI, Zed, Cursor, VS Code, terminals, etc.
#   git worktree add ../feature-x feature/x
#   cd ../feature-x && git-worktree-setup
#   # or from anywhere:
#   git-worktree-setup /path/to/main /path/to/feature-x
#   git-worktree-setup /path/to/feature-x
#
# Options:
#   -n, --dry-run   Show what would be copied
#   -v, --verbose   Verbose copy output
#   --all           Copy all ignored and untracked files (previous behavior)
#   -h, --help      Show help

set -euo pipefail

DRY_RUN=false
VERBOSE=false
COPY_ALL=false
PASS_ARGS=()

usage() {
  sed -n '2,17p' "$0" | sed 's/^# \?//'
  exit 0
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -n | --dry-run) DRY_RUN=true; PASS_ARGS+=(-n); shift ;;
    -v | --verbose) VERBOSE=true; PASS_ARGS+=(-v); shift ;;
    --all) COPY_ALL=true; shift ;;
    -h | --help) usage ;;
    -*)
      echo "Unknown option: $1" >&2
      exit 1
      ;;
    *) break ;;
  esac
done

# Resolve through symlinks so ../lib works when invoked via ~/.local/bin/*
SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
# shellcheck source=../lib/git-worktree.sh
source "$SCRIPT_DIR/../lib/git-worktree.sh"

_gwt_resolve_paths "$@" || exit 1

echo "🌲 Setting up worktree"
echo "   source: $GWT_SRC"
echo "   dest:   $GWT_DEST"
$DRY_RUN && echo "   mode:   dry-run"
$VERBOSE && echo "   mode:   verbose"
echo

if $COPY_ALL; then
  echo "   copy:   all ignored and untracked files"
  "$SCRIPT_DIR/git-worktree-copy-ignored" ${PASS_ARGS[@]+"${PASS_ARGS[@]}"} "$GWT_SRC" "$GWT_DEST"
  "$SCRIPT_DIR/git-worktree-copy-untracked" ${PASS_ARGS[@]+"${PASS_ARGS[@]}"} "$GWT_SRC" "$GWT_DEST"
else
  manifest="$GWT_SRC/.worktree-copy"
  if [[ ! -f "$manifest" ]]; then
    echo "ℹ️  No .worktree-copy manifest in the primary worktree; nothing to copy"
    exit 0
  fi

  paths=()
  while IFS= read -r path || [[ -n "$path" ]]; do
    path="${path%$'\r'}"
    [[ -z "$path" || "$path" == \#* ]] && continue
    case "$path" in
      /*|.|..|../*|*/../*|*/..|./*|*/./*|*/.|.git|.git/*|*/.git|*/.git/*)
        echo "Invalid .worktree-copy path: $path" >&2
        exit 1
        ;;
    esac
    if [[ ! -e "$GWT_SRC/$path" ]]; then
      echo "Missing .worktree-copy path: $path" >&2
      exit 1
    fi
    part=""
    IFS=/ read -ra components <<< "$path"
    for component in "${components[@]}"; do
      part="${part:+$part/}$component"
      if [[ -L "$GWT_SRC/$part" ]]; then
        echo "Symlink paths are not supported in .worktree-copy: $path" >&2
        exit 1
      fi
      if [[ -L "$GWT_DEST/$part" ]]; then
        echo "Refusing to copy through a destination symlink: $path" >&2
        exit 1
      fi
    done
    paths+=("$path")
  done < "$manifest"

  if ((${#paths[@]} == 0)); then
    echo "ℹ️  .worktree-copy contains no paths; nothing to copy"
    exit 0
  fi
  printf '%s\0' "${paths[@]}" | _gwt_copy_paths "$GWT_SRC" "$GWT_DEST" "$DRY_RUN" "$VERBOSE" true
fi

echo
echo "✅ Worktree setup complete"
