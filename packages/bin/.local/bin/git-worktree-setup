#!/usr/bin/env bash
# Set up a worktree with Worktrunk's APFS-aware ignored-file copying.
# Usage: git-worktree-setup [-n] [-v] [SOURCE] [DEST]
#        git-worktree-setup [-n] [-v] DEST
#        git-worktree-setup              # from inside the new worktree
#
# Select ignored files using .worktreeinclude in the source checkout.
# Without an include file, nothing is copied. Existing destination files are kept.
# .worktree-copy and --all are retired; non-ignored untracked files are not copied.

set -euo pipefail

copy_args=(step copy-ignored --require-include)
while [[ $# -gt 0 ]]; do
  case "$1" in
    -n | --dry-run) copy_args+=(--dry-run); shift ;;
    -v | --verbose) copy_args+=(--verbose); shift ;;
    -h | --help) sed -n '2,9p' "$0" | sed 's/^# \?//'; exit 0 ;;
    --all)
      echo "--all is retired; select ignored files with .worktreeinclude." >&2
      exit 1 ;;
    -*) echo "Unknown option: $1" >&2; exit 1 ;;
    *) break ;;
  esac
done
if ! command -v wt >/dev/null 2>&1; then
  echo "Worktrunk (wt) is required for git-worktree-setup." >&2
  exit 1
fi
# Resolve through symlinks so ../lib works when invoked via ~/.local/bin/*
SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
# shellcheck source=../lib/git-worktree.sh
source "$SCRIPT_DIR/../lib/git-worktree.sh"

_gwt_resolve_paths "$@" || exit 1

source_common="$(git -C "$GWT_SRC" rev-parse --path-format=absolute --git-common-dir)"
dest_common="$(git -C "$GWT_DEST" rev-parse --path-format=absolute --git-common-dir)"
if [[ "$source_common" != "$dest_common" ]]; then
  echo "Source and destination must belong to the same repository." >&2
  exit 1
fi
if [[ -f "$GWT_SRC/.worktree-copy" ]]; then
  echo ".worktree-copy is retired; migrate ignored-file patterns to .worktreeinclude." >&2
  exit 1
fi

# Worktrunk defaults to the primary checkout, including a detached primary.
primary="$(_gwt_primary_worktree "$GWT_DEST")"
if [[ "$GWT_SRC" != "$primary" ]]; then
  branch="$(git -C "$GWT_SRC" symbolic-ref --quiet --short HEAD)" || {
    echo "An alternate source must have a checked-out branch." >&2
    exit 1
  }
  copy_args+=(--from "$branch")
fi
exec wt -C "$GWT_DEST" "${copy_args[@]}"
